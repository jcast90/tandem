{
  "name": "@local/tandem",
  "version": "0.1.0",
  "description": "Provider-neutral CLI orchestrator for an outer conversational agent and delegated execution workers.",
  "type": "module",
  "private": true,
  "bin": {
    "tandem": "bin/tandem.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "desktop": "pnpm --dir apps/desktop tauri dev",
    "desktop:build": "pnpm --dir apps/desktop tauri build",
    "desktop:resources": "pnpm --dir apps/desktop exec esbuild ../../src/mcp-server.ts --bundle --platform=node --format=esm --target=node22 --outfile=src-tauri/resources/mcp-server.mjs && pnpm --dir apps/desktop exec esbuild ../../src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=src-tauri/resources/cli.mjs",
    "desktop:web": "pnpm --dir apps/desktop dev:web",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"apps/desktop/src/**/*.{ts,tsx,css}\" \"apps/desktop/*.{ts,json,html}\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"apps/desktop/src/**/*.{ts,tsx,css}\" \"apps/desktop/*.{ts,json,html}\" \"*.md\" \"*.json\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
